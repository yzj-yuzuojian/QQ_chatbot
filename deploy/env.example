# QQ 陪伴机器人 —— 环境变量模板
#
# 用法：
#   sudo mkdir -p /etc/qq-companion
#   sudo cp deploy/env.example /etc/qq-companion/env
#   sudo chmod 600 /etc/qq-companion/env
#   sudo editor /etc/qq-companion/env
#
# 注意：这里**不能**出现任何平台级的 LLM key。
# 一旦设置了 PLATFORM_LLM_KEY / OPENAI_API_KEY 这类变量，
# 程序启动时会直接退出（见 llm/provider.py 的 assert_no_default_provider）。
# 这是故意的：这个产品只允许客户用自己的 key。


# ---- QQ 官方机器人 ----
# 在 https://q.qq.com/ 创建机器人后获得
QQ_APP_ID=
QQ_APP_SECRET=


# ---- 加密密钥（必须）----
# 用来加密客户的 API key。生成方式：
#   python -m companion.cli gen-secret
#
# 警告：丢失后所有客户的 key 都无法解密，必须让他们重新绑定。
# 备份它，且不要提交到 git。
COMPANION_SECRET=


# ---- 中转站（一般不需要改）----
# 代码里已经写死默认值（companion/config.py 的 RELAY_API_BASE）。
# 只有 fork 后想换成自己的站时才需要取消注释并修改。
# COMPANION_API_BASE=https://your-relay.example.com/v1
# COMPANION_SITE_URL=https://your-relay.example.com

# 绑定页对外地址（要能被客户的手机访问到）
# 本地调试用 http://127.0.0.1:18401/bind
COMPANION_BIND_URL=https://bot.example.com/bind
COMPANION_BIND_HOST=127.0.0.1
COMPANION_BIND_PORT=18401


# ---- 数据库 ----
COMPANION_DB=/var/lib/qq-companion/data.db


# ---- 向量记忆（可选）----
# 不配也能跑，会自动退回纯关键词检索（召回率低一些）。
#
# 为什么单独配一套 key：
#   客户自己的聊天 key 里通常没有 embedding 模型
#   （实测某中转站 30 个模型里 0 个 embedding）。
#   这里用平台 key 只为「把文字转成数字」，不生成任何内容。
#
# 推荐 SiliconFlow 的 BAAI/bge-m3（免费、中文第一梯队、1024 维）
# 留空 embed_api_key 也能跑（自动降级为关键词检索）。
# bge-m3 在 SiliconFlow 免费，建议注册一个填上。
COMPANION_EMBED_ENABLED=1
COMPANION_EMBED_API_BASE=https://api.siliconflow.cn/v1
COMPANION_EMBED_API_KEY=
COMPANION_EMBED_MODEL=BAAI/bge-m3


# ---- 运行参数 ----
COMPANION_WORKERS=2
COMPANION_LOG_LEVEL=INFO
